# 複製成 .env 並依需求調整(請勿把真實密碼提交進版控)。
# app.py 不會自動載入 .env;請用 `export $(grep -v '^#' .env | xargs)` 或於部署平台
#(如 Zeabur)的環境變數介面設定。

# ── 登入保護(公開部署強烈建議)──────────────────────────────
# 設定後啟用 HTTP Basic 登入;未設定則不啟用(僅適合本機)。
# 也接受變數名 PASSWORD(部分平台會自動產生)。
SENTINEL_USER=sentinel
SENTINEL_PASSWORD=

# ── 監聽埠 ──────────────────────────────────────────────
# 容器內 entrypoint 會優先用平台注入的 PORT,其次 SENTINEL_PORT,預設 5000。
SENTINEL_PORT=8080
SENTINEL_HOST=0.0.0.0

# ── 資料庫 ──────────────────────────────────────────────
# 方式一:直接給完整連線字串(最明確)
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=
# 方式二:由下列 POSTGRES_* 自動組合(適配 Zeabur)。需要 POSTGRES_HOST。
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=
POSTGRES_DB=zeabur

# ── 授權主機白名單(選用)────────────────────────────────
# 以逗號分隔;留空表示不額外限制(仍需逐次勾選授權確認)。
SENTINEL_ALLOWED_HOSTS=

# ── AI 模組(選用)──────────────────────────────────────
ANTHROPIC_API_KEY=
SENTINEL_AI_MODEL=claude-opus-4-8
