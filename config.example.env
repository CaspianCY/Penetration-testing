# 複製成 .env 並依需求調整。app.py 不會自動載入 .env;
# 請用 `export $(grep -v '^#' .env | xargs)` 或自行匯入環境變數。

# 啟用 AI 模組(Claude)。未設定時 AI 分析會退回規則式引擎。
ANTHROPIC_API_KEY=

# AI 模組使用的模型(預設 claude-opus-4-8)
SENTINEL_AI_MODEL=claude-opus-4-8

# 以逗號分隔的授權主機白名單。留空表示不額外限制(仍需逐次勾選授權確認)。
# 例: SENTINEL_ALLOWED_HOSTS=example.com,staging.example.com,127.0.0.1
SENTINEL_ALLOWED_HOSTS=

# 資料庫連線字串。正式部署請指向 PostgreSQL;未設定時退回單檔 SQLite。
# PostgreSQL 範例:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sentinel
# SQLite(預設):
#   DATABASE_URL=sqlite:///sentinel.db
DATABASE_URL=

# Flask 監聽位址 / 連接埠
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=5000
